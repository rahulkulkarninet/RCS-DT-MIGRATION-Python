{
    "tblAccount": {
        "base_config":{
            "table": "tblAccount",
            "filter_by": "loadid",
            "from_table": "RC_ACCOUNT_EXTRACT"
        },
        "metrics": [
            {
                "type": "count",
                "column": "AccountID",
                "description": "Total Accounts migrated",
                "result_column": "rows_inserted"
            },
            {
                "type": "sum",
                "column": "LUPTotalPrincipal",
                "description": "Total Principal migrated",
                "result_column": "total_debt"
            },
            {
                "type": "sum",
                "column": "LUPTotalCost",
                "description": "Total Cost migrated",
                "result_column": "total_costs"
            },
            {
                "type": "sum",
                "column": "(LUPTotalPayment - LUPTotalOverPaymentTrust)",
                "description": "Total Payment migrated",
                "result_column": "total_paid"
            },
            {
                "type": "sum",
                "column": "LUPTotalOverPaymentTrust",
                "description": "Total Overpayment Trust migrated",
                "result_column":"total_overpayments"
            }
        ]

    },
